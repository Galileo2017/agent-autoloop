      "html": "<header class=\"ds-bar\"><span class=\"ds-bar-name\">Agent Autoloop</span><div class=\"ds-bar-facts\"><span><span class=\"ds-dot on\"></span>中台在线</span><span>今日 <b>$1.24</b> · 6 轮</span><span>7 天 <b>$8.90</b></span></div></header>",
      "css": ".ds-bar{display:flex;align-items:baseline;justify-content:space-between;gap:16px;flex-wrap:wrap;font-size:14px;color:var(--ink-mid,#a6a193)}.ds-bar-name{font-size:14px;letter-spacing:.16em;color:var(--ink-mid,#a6a193);text-transform:uppercase}.ds-bar-facts{display:flex;gap:20px;flex-wrap:wrap;justify-content:flex-end;flex:1;min-width:0;letter-spacing:.02em}.ds-bar-facts b{color:var(--ink,#e7e2d4);font-weight:600}.ds-dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--ink-mid,#a6a193);margin-right:6px;vertical-align:1px}.ds-dot.on{background:var(--ink,#e7e2d4)}.ds-dot.off{background:transparent;box-shadow:inset 0 0 0 1px var(--ink-faint,#928d7f)}"
