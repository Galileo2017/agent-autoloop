      "html": "<footer class=\"ds-legend\"><div class=\"ds-legend-key\"><span class=\"ds-tick\"><span class=\"ds-swatch\" style=\"background:var(--wl-3,#43cf8e)\"></span>deploy.production</span><span class=\"ds-tick\"><span class=\"ds-swatch\" style=\"background:repeating-linear-gradient(90deg, var(--sodium,#f2d30b) 0 4px, transparent 4px 7px)\"></span>2 条事件没被接走</span><span class=\"ds-gap\">|</span><span class=\"ds-tick\"><span class=\"ds-dot off\"></span>worker</span><span>今日 <b>$1.24</b> · 84,210 token</span></div></footer>",
      "css": ".ds-legend{display:flex;align-items:baseline;gap:22px;flex-wrap:wrap;font-size:14px;color:var(--ink-faint,#928d7f);padding-top:12px;border-top:1px solid var(--hair,#3a3d3e)}.ds-legend-key{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap}.ds-tick{display:inline-flex;align-items:baseline;gap:6px;color:var(--ink-mid,#a6a193)}.ds-tick b{font-weight:600}.ds-swatch{width:2px;height:12px;display:inline-block;transform:translateY(1px)}.ds-gap{color:var(--hair,#3a3d3e)}.ds-dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--ink-mid,#a6a193);margin-right:6px;vertical-align:1px}.ds-dot.on{background:var(--ink,#e7e2d4)}.ds-dot.off{background:transparent;box-shadow:inset 0 0 0 1px var(--ink-faint,#928d7f)}"
